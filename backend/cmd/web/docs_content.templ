package web

import (
	"backend/cmd/web/components"
	"backend/internal/docs"
)

// DocsContent renders a documentation page with the three-column layout
templ DocsContent(doc *docs.Doc, sidebar []docs.SidebarItem, currentPath string) {
	@DocsContentWithAuth(doc, sidebar, currentPath, "")
}

// DocsContentWithAuth renders a documentation page with optional auth state
templ DocsContentWithAuth(doc *docs.Doc, sidebar []docs.SidebarItem, currentPath string, userEmail string) {
	@BaseWithAuth(doc.Title+" – CannaNote", currentPath, userEmail) {
		@components.DocsContentLayout(doc, sidebar, currentPath)
	}
}

// DocsContentPartial renders just the main content for HTMX swaps
templ DocsContentPartial(doc *docs.Doc) {
	@components.DocsContentPartial(doc)
}