// Mobile navigation item helper - uses unified isNavActive for consistency
templ mobileNavItem(href, label, currentPath string, icon templ.Component) {
	if isNavActive(href, currentPath) {
		<a
			href={ templ.SafeURL(href) }
			class="flex flex-col items-center justify-center gap-1 px-3 py-2 rounded-lg text-sage-600 dark:text-sage-400"
			aria-current="page"
		>
			@icon
			<span class="text-xs font-medium">{ label }</span>
		</a>
	} else {
		<a
			href={ templ.SafeURL(href) }
			class="flex flex-col items-center justify-center gap-1 px-3 py-2 rounded-lg text-gray-500 dark:text-gray-400 active:bg-gray-100 dark:active:bg-navy-800"
		>
			@icon
			<span class="text-xs">{ label }</span>
		</a>
	}
}

// Mobile navigation icons (larger touch targets, filled when active)
