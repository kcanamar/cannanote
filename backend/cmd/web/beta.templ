package web

templ BetaSignupSuccess(email string) {
	<div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 dark:border-emerald-800 rounded-lg">
		<div class="flex justify-center">
			<svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
			</svg>
			<div>
				<h3 class="text-emerald-800 dark:text-emerald-300 font-semibold">Check your email!</h3>
				<p class="text-emerald-700 dark:text-emerald-400 text-sm mt-1">
					We've sent an activation email to { email }
				</p>
			</div>
		</div>

		<div class="mt-4 pt-4 border-t border-emerald-200 dark:border-emerald-800">
			<p class="text-emerald-700 dark:text-emerald-400 text-sm">
				<strong>Next step:</strong> Click the activation link in the email to verify your account and set your password.
			</p>
			<p class="text-emerald-600 dark:text-emerald-500 text-xs mt-2">
				As a beta member, you'll receive lifetime access to premium sync features.
				Your cannabis data stays local-first on your device.
			</p>
		</div>
	</div>
}

templ BetaSignupError(message string) {
	<div class="p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
		<div class="flex justify-center">
			<svg class="w-6 h-6 text-red-600 dark:text-red-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
			</svg>
			<div>
				<h3 class="text-red-800 dark:text-red-300 font-semibold">Signup issue</h3>
				<p class="text-red-700 dark:text-red-400 text-sm mt-1">{ message }</p>
			</div>
		</div>
	</div>
}