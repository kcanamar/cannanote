package components

import (
	"backend/internal/docs"
	"backend/internal/version"
	"strconv"
	"strings"
)

// boolToString converts a bool to "true" or "false" string for aria attributes
func boolToString(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

// shouldFolderBeOpen determines if a folder should be open based on current path
func shouldFolderBeOpen(folder docs.SidebarItem, currentPath string) bool {
	// Check if folder's own href matches
	if folder.Href != "" && folder.Href == currentPath {
		return true
	}
	// Check if current path is within this section
	if folder.Section != "" && strings.Contains(currentPath, "/"+folder.Section+"/") {
		return true
	}
	// Recursively check children
	for _, child := range folder.Children {
		if child.Href == currentPath {
			return true
		}
		// If child is a folder, check its children recursively
		if child.IsFolder && shouldFolderBeOpen(child, currentPath) {
			return true
		}
	}
	return false
}

// docsTOCSidebar renders the table of contents sidebar
templ docsTOCSidebar(doc *docs.Doc) {
	if len(doc.TOC) > 0 {
		<aside id="docs-toc-sidebar" class="hidden xl:block border-l border-neutral-200 dark:border-navy-700 bg-white dark:bg-navy-900">
			<style>#docs-toc-sidebar .toc-scroll::-webkit-scrollbar { display: none; }</style>
			<div class="toc-scroll sticky top-[73px] h-[calc(100vh-73px)] overflow-y-auto p-6 pb-32" style="-ms-overflow-style: none; scrollbar-width: none;">
				<h3 class="text-sm font-semibold text-neutral-900 dark:text-white uppercase tracking-wider mb-4">
					On This Page
				</h3>
				<nav class="space-y-1">
					<ul id="toc-list" class="space-y-1 text-sm">
						for _, item := range doc.TOC {
							<li class={ "ml-" + strconv.Itoa((item.Level - 2) * 4) }>
								<a
									href={ templ.SafeURL("#" + item.ID) }
									data-toc-link={ item.ID }
									class="toc-link block py-1 text-neutral-600 dark:text-neutral-400 hover:text-sage-600 dark:hover:text-sage-400 transition truncate"
								>
									{ item.Text }
								</a>
							</li>
						}
					</ul>
				</nav>
			</div>
		</aside>
		@tocScrollSpy()
	} else {
		<aside id="docs-toc-sidebar" class="hidden xl:block border-l border-neutral-200 dark:border-navy-700 bg-white dark:bg-navy-900">
			<div class="sticky top-[73px] h-[calc(100vh-73px)] p-6">
				<div class="text-sm text-neutral-500 dark:text-neutral-400">
					No headings on this page
				</div>
			</div>
		</aside>
	}
}

// navFooterObserver hides the nav when footer comes into view
templ navFooterObserver() {
	<script>
		(function() {
			const nav = document.querySelector('nav[aria-label="Main navigation"]');
			const footer = document.querySelector('footer');
			if (!nav || !footer) return;

			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						// Footer is visible - slide nav up out of view
						nav.style.transform = 'translateY(-100%)';
						nav.style.transition = 'transform 0.3s ease-out';
					} else {
						// Footer not visible - restore nav
						nav.style.transform = 'translateY(0)';
					}
				});
			}, {
				threshold: 0.1
			});

			observer.observe(footer);
		})();
	</script>
}

// tocScrollSpy adds scroll-spy behavior to highlight active TOC item
templ tocScrollSpy() {
	<script>
		(function() {
			const tocLinks = document.querySelectorAll('.toc-link');
			const tocContainer = document.querySelector('#docs-toc-sidebar .toc-scroll');
			if (!tocLinks.length || !tocContainer) return;

			const activeClass = 'text-sage-600 dark:text-sage-400 font-medium';
			const inactiveClass = 'text-neutral-600 dark:text-neutral-400';
			const footerBuffer = 96; // 6rem buffer from bottom

			function setActiveLink(id) {
				let activeLink = null;

				tocLinks.forEach(link => {
					const linkId = link.getAttribute('data-toc-link');
					if (linkId === id) {
						link.className = `toc-link block py-1 ${activeClass} hover:text-sage-600 dark:hover:text-sage-400 transition truncate`;
						activeLink = link;
					} else {
						link.className = `toc-link block py-1 ${inactiveClass} hover:text-sage-600 dark:hover:text-sage-400 transition truncate`;
					}
				});

				// Auto-scroll TOC to keep active link near bottom of visible area
				if (activeLink) {
					const containerHeight = tocContainer.clientHeight;
					const linkOffsetTop = activeLink.offsetTop;
					const linkHeight = activeLink.offsetHeight;

					// Target position: keep link near bottom (with buffer from edge)
					const targetScroll = linkOffsetTop - containerHeight + linkHeight + footerBuffer;

					// Clamp scroll position (min 0, no max needed for this direction)
					const clampedScroll = Math.max(0, targetScroll);

					tocContainer.scrollTo({
						top: clampedScroll,
						behavior: 'smooth'
					});
				}
			}

			// Get all heading IDs from TOC links
			const headingIds = Array.from(tocLinks).map(link => link.getAttribute('data-toc-link'));
			const headings = headingIds.map(id => document.getElementById(id)).filter(Boolean);

			if (!headings.length) return;

			// Use IntersectionObserver for scroll spy
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						setActiveLink(entry.target.id);
					}
				});
			}, {
				rootMargin: '-80px 0px -70% 0px',
				threshold: 0
			});

			headings.forEach(heading => observer.observe(heading));

			// Detect when at bottom of page - activate last heading
			function checkBottomOfPage() {
				const scrolledToBottom = (window.innerHeight + window.scrollY) >= (document.body.scrollHeight - 100);
				if (scrolledToBottom && headings.length > 0) {
					const lastHeading = headings[headings.length - 1];
					setActiveLink(lastHeading.id);
				}
			}

			window.addEventListener('scroll', checkBottomOfPage, { passive: true });

			// Set initial active state
			if (headings[0]) setActiveLink(headings[0].id);
		})();
	</script>
}

// DocsContentLayout creates the three-column layout for documentation
templ DocsContentLayout(doc *docs.Doc, sidebar []docs.SidebarItem, currentPath string) {
	<!-- Hide nav when footer is visible -->
	@navFooterObserver()

	<!-- CSS Grid: 1 col on mobile, 2 col on lg, 3 col on xl -->
	<div class="grid grid-cols-1 lg:grid-cols-[18rem_1fr] xl:grid-cols-[18rem_1fr_16rem] min-h-screen bg-white dark:bg-navy-950">
		<!-- Left Sidebar - Navigation -->
		<aside class="hidden lg:block border-r border-neutral-200 dark:border-navy-700 bg-white dark:bg-navy-900">
			<div class="sticky top-[73px] h-[calc(100vh-73px)] overflow-y-auto p-6">
				<!-- Search Box -->
				<div class="mb-6">
					<div class="relative">
						<svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-neutral-400 dark:text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
						</svg>
						<input
							type="search"
							placeholder="Search docs..."
							class="w-full pl-10 pr-4 py-2 text-sm border border-neutral-200 dark:border-navy-700 rounded-lg bg-neutral-50 dark:bg-navy-800 text-navy-900 dark:text-white placeholder-neutral-500 dark:placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-sage-500 focus:border-transparent"
						/>
					</div>
				</div>
				<!-- Navigation Tree -->
				<nav class="space-y-1">
					@docsNavigationTree(sidebar, currentPath)
				</nav>
				<!-- Footer -->
				<div class="mt-8 pt-6 border-t border-neutral-200 dark:border-navy-700">
					<div class="text-xs text-neutral-500 dark:text-neutral-400">
						<span>{ version.GetVersion() }</span>
					</div>
				</div>
			</div>
		</aside>

		<!-- Main Content Area -->
		<main class="min-w-0">
			<!-- Mobile Navigation Toggle -->
			<div class="lg:hidden sticky top-[73px] z-10 bg-white dark:bg-navy-950 border-b border-neutral-200 dark:border-navy-700 p-4">
				<button
					id="mobile-nav-toggle"
					class="flex items-center text-neutral-600 dark:text-neutral-400 hover:text-sage-600 dark:hover:text-sage-400 transition"
					onclick="toggleMobileNav()"
				>
					<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
					</svg>
					Navigation
				</button>
			</div>

			<!-- Main Content Container - HTMX Target -->
			<div id="main-content">
				<!-- Article Content -->
				<article class="px-6 pt-12 pb-8 lg:px-8 lg:pt-16 lg:pb-12 max-w-4xl">
					<!-- Article Header -->
					<header class="mb-8">
						<h1 class="text-3xl font-bold text-navy-900 dark:text-white mb-4">{ doc.Title }</h1>
						if doc.Description != "" {
							<p class="text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">{ doc.Description }</p>
						}
					</header>

					<!-- Article Body -->
					<div class="prose prose-lg max-w-none dark:prose-invert">
						@templ.Raw(doc.ContentHTML)
					</div>

					<!-- Article Footer -->
					if len(doc.RelatedPages) > 0 {
						<footer class="mt-12 pt-8 border-t border-neutral-200 dark:border-navy-700">
							<h3 class="text-lg font-medium text-navy-900 dark:text-white mb-4">Related Pages</h3>
							<div class="grid md:grid-cols-2 gap-4">
								for _, related := range doc.RelatedPages {
									<a href={ "/docs/" + related } class="block p-4 border border-neutral-200 dark:border-navy-700 rounded-lg hover:border-sage-300 dark:hover:border-sage-600 transition">
										<span class="text-sage-600 dark:text-sage-400 font-medium">{ related }</span>
									</a>
								}
							</div>
						</footer>
					}
				</article>
			</div>
		</main>

		<!-- Right Sidebar - TOC -->
		@docsTOCSidebar(doc)
	</div>

	<!-- Mobile Navigation Overlay (outside grid) -->
	<div
		id="mobile-nav-overlay"
		class="fixed inset-0 z-50 lg:hidden hidden transition-opacity duration-300"
		onclick="toggleMobileNav()"
	>
		<!-- Background overlay -->
		<div class="absolute inset-0 bg-navy-900/80 backdrop-blur-sm"></div>

		<!-- Slide-out navigation panel -->
		<div class="absolute right-0 top-0 bottom-0 w-80 max-w-[85vw] bg-white dark:bg-navy-900 shadow-2xl transform transition-transform duration-300 ease-out" onclick="event.stopPropagation()">
			<!-- Header with logo and close button -->
			<div class="flex items-center justify-between p-4 border-b border-neutral-200 dark:border-navy-700 bg-sage-50 dark:bg-navy-800">
				<div class="flex items-center space-x-3">
					<svg class="w-8 h-8 text-sage-600 dark:text-sage-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C20.168 18.477 18.582 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
					</svg>
					<span class="text-lg font-semibold text-navy-900 dark:text-white">Documentation</span>
				</div>
				<button
					onclick="toggleMobileNav()"
					class="p-2 text-neutral-500 dark:text-neutral-400 hover:text-sage-600 dark:hover:text-sage-400 hover:bg-sage-100 dark:hover:bg-navy-700 rounded-lg transition-colors"
					aria-label="Close navigation"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
					</svg>
				</button>
			</div>

			<!-- Navigation content -->
			<div class="overflow-y-auto h-full pb-20">
				<div class="p-4">
					<nav class="space-y-2">
						@docsNavigationTree(sidebar, currentPath)
					</nav>
				</div>
			</div>

			<!-- Footer with branding -->
			<div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-white to-transparent dark:from-navy-900 border-t border-neutral-200 dark:border-navy-700">
				<div class="text-center">
					<p class="text-xs text-neutral-500 dark:text-neutral-400">
						CannaNote Documentation
					</p>
				</div>
			</div>
		</div>
	</div>
}

// Helper template for navigation tree
templ docsNavigationTree(items []docs.SidebarItem, currentPath string) {
	for _, item := range items {
		if item.IsFolder {
			@docsNavigationFolder(item, currentPath)
		} else {
			@docsNavigationItem(item, currentPath)
		}
	}
	@folderToggleScript()
}

// folderToggleScript provides the JavaScript for folder expand/collapse
templ folderToggleScript() {
	<script>
		function toggleFolder(button) {
			const isExpanded = button.getAttribute('aria-expanded') === 'true';
			const folderNav = button.closest('.folder-nav');
			const content = folderNav.querySelector('.folder-content');
			const icon = button.querySelector('svg');

			if (isExpanded) {
				content.classList.add('hidden');
				button.setAttribute('aria-expanded', 'false');
				icon.style.transform = 'rotate(0deg)';
			} else {
				content.classList.remove('hidden');
				button.setAttribute('aria-expanded', 'true');
				icon.style.transform = 'rotate(90deg)';
			}
		}

		// Initialize icon rotation based on aria-expanded state
		document.querySelectorAll('.folder-toggle').forEach(button => {
			const isExpanded = button.getAttribute('aria-expanded') === 'true';
			const icon = button.querySelector('svg');
			if (isExpanded && icon) {
				icon.style.transform = 'rotate(90deg)';
			}
		});
	</script>
}

// Helper template for folder navigation items (collapsible sections)
templ docsNavigationFolder(folder docs.SidebarItem, currentPath string) {
	<div class="folder-nav">
		<div class="flex items-center gap-1">
			if folder.Href != "" {
				<a
					href={ folder.Href }
					class={ "flex-1 px-3 py-2 text-sm font-semibold rounded-md transition hover:bg-neutral-100 dark:hover:bg-navy-800",
						templ.KV("text-sage-700 dark:text-sage-300", folder.Href == currentPath),
						templ.KV("text-neutral-900 dark:text-white", folder.Href != currentPath) }
					hx-get={ folder.Href }
					hx-target="#main-content"
					hx-swap="innerHTML"
					hx-push-url="true"
				>
					{ folder.Label }
				</a>
			} else {
				<span class="flex-1 px-3 py-2 text-sm font-semibold text-neutral-900 dark:text-white">
					{ folder.Label }
				</span>
			}
			<button
				type="button"
				class="folder-toggle p-2 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-navy-800 rounded-md transition"
				aria-expanded={ boolToString(shouldFolderBeOpen(folder, currentPath)) }
				aria-label={ "Toggle " + folder.Label + " section" }
				onclick="toggleFolder(this)"
			>
				<svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
				</svg>
			</button>
		</div>
		<div
			class={ "folder-content ml-4 mt-1 space-y-1 border-l border-neutral-200 dark:border-navy-700 pl-3",
				templ.KV("hidden", !shouldFolderBeOpen(folder, currentPath)) }
		>
			for _, child := range folder.Children {
				if child.IsFolder {
					@docsNavigationFolder(child, currentPath)
				} else {
					@docsNavigationItem(child, currentPath)
				}
			}
		</div>
	</div>
}

// Helper template for individual navigation items (files)
templ docsNavigationItem(item docs.SidebarItem, currentPath string) {
	if item.Href == currentPath || (currentPath != "" && currentPath == strings.TrimPrefix(item.Href, "/docs/")) {
		<a
			href={ item.Href }
			class="flex items-center px-3 py-2 text-sm font-medium text-sage-700 dark:text-sage-300 bg-sage-50 dark:bg-sage-900/30 border-r-2 border-sage-600 dark:border-sage-400 rounded-l-md transition"
			aria-current="page"
			hx-get={ item.Href }
			hx-target="#main-content"
			hx-swap="innerHTML"
			hx-push-url="true"
		>
			<span class="truncate">{ item.Label }</span>
		</a>
	} else {
		<a
			href={ item.Href }
			class="flex items-center px-3 py-2 text-sm text-neutral-700 dark:text-neutral-300 hover:text-sage-700 dark:hover:text-sage-300 hover:bg-neutral-50 dark:hover:bg-navy-800 rounded-md transition"
			hx-get={ item.Href }
			hx-target="#main-content"
			hx-swap="innerHTML"
			hx-push-url="true"
		>
			<span class="truncate">{ item.Label }</span>
		</a>
	}
}