# =============================================================================
# CannaNote Monorepo .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Environment
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.ipr
*.iws

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# Logs
*.log
npm-debug.log*

# Temp files
*.tmp
*.bak
*.cache

# -----------------------------------------------------------------------------
# Zig (desktop-zig/)
# -----------------------------------------------------------------------------

# Build output
**/zig-out/
**/.zig-cache/
**/zig-pkg/

# Local SQLite database
cannanote.db
cannanote.db-journal
cannanote.db-wal
cannanote.db-shm

# -----------------------------------------------------------------------------
# Flutter / Dart (mobile/)
# -----------------------------------------------------------------------------

# Dart/Flutter artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
/coverage/

# Generated files
*.g.dart
*.freezed.dart
*.mocks.dart
*.gr.dart

# Drift/Moor generated
*.drift.dart

# Flutter specific
**/doc/api/
**/ios/Flutter/.last_build_id
.packages
.metadata

# Generated launcher icons (regenerate with: dart run flutter_launcher_icons)
# Keep source: mobile/assets/icon/app_icon.png
**/mipmap-*/ic_launcher.png
**/AppIcon.appiconset/*.png
**/LaunchImage.imageset/*.png

# Symbolication
app.*.symbols

# Obfuscation
app.*.map.json

# Android
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
*.jks
*.keystore

# iOS
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata
**/ios/.generated/
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# macOS (Flutter desktop)
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral

# Linux (Flutter desktop)
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake
**/linux/flutter/ephemeral

# Windows (Flutter desktop)
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake
**/windows/flutter/ephemeral

# -----------------------------------------------------------------------------
# Node.js (if any tooling)
# -----------------------------------------------------------------------------

node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# -----------------------------------------------------------------------------
# Go (backend/)
# -----------------------------------------------------------------------------

# Binary output
/backend/bin/
/backend/cmd/web/web

# Air live reload
/backend/tmp/

# -----------------------------------------------------------------------------
# Protocol Buffers (shared/ - future)
# -----------------------------------------------------------------------------

**/generated/

# -----------------------------------------------------------------------------
# Project specific
# -----------------------------------------------------------------------------

/.*.json
/media/*
!media/.gitkeep
